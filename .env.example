OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=90
OLLAMA_RETRIES=3
OLLAMA_RETRY_BACKOFF_SEC=2.0
APP_ENV=dev
DEFAULT_LANGUAGE=ru
SUPPORTED_LANGUAGES=ru,en

RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
EVAL_DATA_DIR=data/eval

CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
SYNTHETIC_BATCH_SIZE=6

CHROMA_DIR=.chroma
CHROMA_COLLECTION=graphrag_chunks
